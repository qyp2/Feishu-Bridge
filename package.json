{
  "name": "feishu-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge OpenCode into Feishu/Lark bots with streaming cards, session isolation, cron and health monitoring.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "feishu-bridge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "tsx src/index.ts doctor"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.75.0",
    "@opencode/client": "^2.0.27",
    "croner": "^9.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
